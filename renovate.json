{
  "extends": ["github>whtsky/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^LIBARCHIVE_VERSION$/"
      ],
      "matchStrings": ["(?<currentValue>v[\\d\\.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "libarchive/libarchive"
    }
  ]
}
